{
  "name": "@ediocracy/guide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:api && vitepress dev",
    "build": "pnpm run check && vitepress build",
    "preview": "vitepress preview",
    "check": "pnpm run docs:api && pnpm run test && vue-tsc --noEmit && pnpm run check:content && pnpm run check:snippets",
    "check:content": "node scripts/check-content.mjs",
    "check:snippets": "tsc -p parser/snippets && node scripts/run-snippets.mjs",
    "docs:api": "typedoc",
    "test": "vitest run"
  },
  "dependencies": {
    "@ediocracy/parser": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "vitest": "catalog:",
    "vue-tsc": "3.3.14"
  }
}
