{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedSideEffectImports": false,
    "types": ["node"]
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.mjs", ".vitepress/**/*.vue"]
}
