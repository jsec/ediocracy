{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../../packages/parser/src/index.ts",
    "../../packages/parser/src/profiles/271/index.ts",
    "../../packages/parser/src/profiles/271/routes/index.ts",
    "../../packages/parser/src/profiles/acknowledgements/index.ts"
  ],
  "tsconfig": "../../packages/parser/tsconfig.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./scripts/typedoc-hide-object-signatures.mjs",
    "./scripts/typedoc-short-paths.mjs"
  ],
  "out": "./parser/api",
  "docsRoot": "./",
  "readme": "none",
  "validation": {
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "pageTitleTemplates": {
    "member": "{name}"
  },
  "parametersFormat": "table",
  "router": "short-paths",
  "excludeScopesInPaths": true,
  "typeAliasPropertiesFormat": "table",
  "tableColumnSettings": {
    "hideSources": true
  }
}
